{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dasheng.video.script.v1",
  "title": "Dasheng Video Script",
  "type": "object",
  "required": ["schema_version", "title", "lane", "segments"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "dasheng.video.script.v1"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "type": "string",
      "enum": ["talking_head_video", "explainer_html_video", "vox_explainer_video"]
    },
    "central_question": {
      "type": "string",
      "minLength": 1
    },
    "editorial_mode": {
      "type": "string",
      "enum": ["core_alignment", "paragraph_alignment"]
    },
    "core_claims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "retention_plan": {
      "type": "object",
      "additionalProperties": true
    },
    "voice": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "voice_id": {
          "type": "string"
        },
        "speed": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        }
      },
      "additionalProperties": true
    },
    "presenter_source": {
      "type": "object",
      "properties": {
        "kind": {"type": "string", "enum": ["human_video", "digital_human"]},
        "engine": {"type": "string"},
        "portrait": {"type": "string"},
        "consent_status": {"type": "string", "enum": ["confirmed", "not_required", "not_confirmed"]}
      },
      "additionalProperties": true
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "beat_class"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "beat_class": {
            "type": "string",
            "enum": ["hook", "creator_intro", "claim", "evidence_data", "evidence_document", "logic_chain", "audience_interaction", "retention_bridge", "objection", "counterargument", "chapter", "recap", "conclusion"]
          },
          "narrative_role": {
            "type": "string"
          },
          "viewer_prompt": {
            "type": "string"
          },
          "retention_function": {
            "type": "string"
          },
          "source_claim_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "start_sec": {
            "type": "number",
            "minimum": 0
          },
          "end_sec": {
            "type": "number",
            "minimum": 0
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lane": {
            "const": "vox_explainer_video"
          }
        }
      },
      "then": {
        "required": ["central_question", "editorial_mode", "core_claims", "retention_plan"]
      }
    }
  ],
  "additionalProperties": true
}
