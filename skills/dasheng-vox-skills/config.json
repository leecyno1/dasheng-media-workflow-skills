{
  "name": "dasheng-vox-skills",
  "version": "1.0.0",
  "lane": "vox_explainer_video",
  "pipeline": "configs/video/pipelines/vox_explainer.yaml",
  "manifest_entry": "skills/dasheng-vox-skills/scripts/vox_manifest.py",
  "gemini_api_entry": "skills/dasheng-vox-skills/scripts/gemini_video_api.py",
  "shot_qc_entry": "skills/dasheng-vox-skills/scripts/shot_qc.py",
  "components": [
    "dasheng-video-vox",
    "dasheng-video-omni-browser",
    "imagegen",
    "remotion"
  ],
  "default_provider_order": [
    "gemini_api_omni",
    "gemini_api_veo",
    "gemini_browser_omni",
    "remotion_local_motion"
  ],
  "reference_image_provider": "codex_builtin_imagegen",
  "default_format": {
    "aspect_ratio": "16:9",
    "width": 1920,
    "height": 1080,
    "fps": 30
  }
}
